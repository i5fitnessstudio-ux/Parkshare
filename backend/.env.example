# ParkShare Backend Environment Configuration
# Copy to .env and fill real values. Never commit real secrets.

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=parkshare
DB_USER=parkshare
DB_PASSWORD=

# HTTP server
PORT=8080

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES_MINUTES=60
REFRESH_TOKEN_DAYS=30

# Password policy
MIN_PASSWORD_LENGTH=8
AUTH_RATE_LIMIT_PER_MINUTE=30

# Razorpay (server-side only - NEVER put these in the Flutter app)
# Leave empty to keep the online-payment option disabled.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MODE=test
# Route / marketplace settlement. Leave FALSE until Route is confirmed enabled
# on the Razorpay account; FALSE records earnings internally as PENDING only.
RAZORPAY_ROUTE_ENABLED=false
PARKSHARE_COMMISSION_PERCENT=0