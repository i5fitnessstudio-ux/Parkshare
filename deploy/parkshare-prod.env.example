# =============================================================================
# /opt/parkshare/parkshare-prod.env
#
# Production environment for the parkshare-backend container.
# Copy this file, fill the REPLACE_* values, then:   chmod 600 parkshare-prod.env
#
# This file is loaded by the overlay (docker-compose.prod.yml) AND is never
# baked into the image. Add it to .gitignore if this project is versioned.
# =============================================================================

# ---- Runtime ----------------------------------------------------------------
# Forces the startup validation path in backend/bin/server.dart. Do NOT leave
# this as development for production.
APP_ENV=production
PORT=8080
# Request access logging. Useful during go-live; may be turned off later.
LOG_REQUESTS=true

# ---- PostgreSQL (Docker service name, NOT 127.0.0.1) ------------------------
DB_HOST=parkshare-db
DB_PORT=5432
DB_NAME=parkshare
DB_USER=parkshare
DB_PASSWORD=REPLACE_STRONG_DB_PASSWORD

# ---- JWT --------------------------------------------------------------------
# Generate a FRESH secret (>= 32 chars). Never reuse the value from
# backend/.env in the repo:
#     openssl rand -hex 48
JWT_SECRET=REPLACE_WITH_64_HEX_CHARS
JWT_ACCESS_EXPIRES_MINUTES=60
REFRESH_TOKEN_DAYS=30

# ---- Password policy --------------------------------------------------------
# Authentication is register / login / refresh / me / logout only.
# ParkShare does not use OTP, email OTP, SMTP or email delivery.
MIN_PASSWORD_LENGTH=8
AUTH_RATE_LIMIT_PER_MINUTE=30

# ---- Public URL / CORS ------------------------------------------------------
# PUBLIC_BASE_URL becomes the absolute prefix for uploaded photo URLs.
# CORS: mobile apps send no Origin header, so this only matters for a browser;
# a non-empty value is nonetheless REQUIRED by startup validation in production.
PUBLIC_BASE_URL=https://api.example.com
CORS_ALLOWED_ORIGINS=https://api.example.com

# ---- Uploads ----------------------------------------------------------------
# Absolute path inside the container, backed by the parkshare_uploads volume.
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_BYTES=8388608

# ---- Razorpay (server-side only) --------------------------------------------
# TEST first: keys start with rzp_test_. Live keys (rzp_live_) come at the very
# end, only after the physical-phone test passes.
RAZORPAY_KEY_ID=REPLACE_rzp_test_key_id
RAZORPAY_KEY_SECRET=REPLACE_rzp_test_key_secret
# From Razorpay Dashboard > Settings > Webhooks (the "Webhook Secret" field).
RAZORPAY_WEBHOOK_SECRET=REPLACE_webhook_secret
RAZORPAY_MODE=test
# Keep FALSE until Razorpay Route is confirmed enabled on the account.
RAZORPAY_ROUTE_ENABLED=false
PARKSHARE_COMMISSION_PERCENT=0

# ---- Manual owner payouts ---------------------------------------------------
# Route is unavailable for this business (RBI turnover/payer-payee rules), so
# owner bank details are stored encrypted and an admin executes the payout.
# Generate ONCE and keep it stable; changing it makes existing details
# unreadable and forces every owner to re-submit their bank account:
#     openssl rand -hex 48
OWNER_PAYOUT_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARS
